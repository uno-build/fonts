diff --git a/msdf-atlas-gen/Workload.cpp b/msdf-atlas-gen/Workload.cpp
--- a/msdf-atlas-gen/Workload.cpp
+++ b/msdf-atlas-gen/Workload.cpp
@@ -1,10 +1,12 @@
 
 #include "Workload.h"
 
+#include <algorithm>
+#if MSDF_ATLAS_ENABLE_THREADS
 #include <vector>
 #include <thread>
 #include <atomic>
-#include <algorithm>
+#endif
 
 namespace msdf_atlas {
 
@@ -20,6 +22,7 @@ bool Workload::finishSequential() {
 }
 
 bool Workload::finishParallel(int threadCount) {
+#if MSDF_ATLAS_ENABLE_THREADS
     std::atomic<bool> result(true);
     std::atomic<int> next(0);
     std::function<void(int)> threadWorker = [this, &result, &next](int threadNo) {
@@ -35,16 +38,25 @@ bool Workload::finishParallel(int threadCount) {
     for (std::thread &thread : threads)
         thread.join();
     return result;
+#else
+    (void) threadCount;
+    return finishSequential();
+#endif
 }
 
 bool Workload::finish(int threadCount) {
     if (!chunks)
         return true;
+    #if !MSDF_ATLAS_ENABLE_THREADS
+    (void) threadCount;
+    return finishSequential();
+    #else
     if (threadCount == 1 || chunks == 1)
         return finishSequential();
     if (threadCount > 1)
         return finishParallel(std::min(threadCount, chunks));
     return false;
+    #endif
 }
 
 }
